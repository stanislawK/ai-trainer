.git
.venv
__pycache__
*.pyc
.mypy_cache
.pytest_cache
.ruff_cache
.coverage
# Secrets never reach the build context, at any depth (ADR-0023 invariant 6).
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
!.env.example
docs
tests
scripts
!scripts/build_css.sh
!scripts/css_versions.sh
!scripts/css_tools.sh
!scripts/watch_css.sh
!scripts/dev_start.sh
!scripts/healthcheck.py
.claude
*.md

# Local LLM traffic log (ADR-0018): prompts and replies never go into an image.
.llm-debug

# Local state: `make smoke-setup` writes test keys and env files here (#221), acceptance
# screenshots and Playwright MCP output stay on the developer's machine.
.smoke
.acceptance
.playwright-mcp
.import_linter_cache
