# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# PostgreSQL with pgvector (ADR-0004).
DATABASE_URL=postgresql+psycopg://ai_trainer:ai_trainer@localhost:5432/ai_trainer

# LLM gateway (ADR-0007, ADR-0018). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
LLM_CALL_TIMEOUT_SECONDS=30

# Google sign-in (ADR-0005). Create an OAuth 2.0 client (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with authorized redirect URI
# http://localhost:8000/auth/callback. No Google access or refresh token is ever stored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs Starlette's transient OAuth-state cookie; generate with `openssl rand -hex 32`.
SESSION_SECRET_KEY=
# Comma-separated; a verified Google email in this list bootstraps the first admin account
# as `active` (ADR-0005). Leave empty and every new account stays `pending`.
ADMIN_EMAILS=
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=14

# Tracing over OTLP (ADR-0018). Off by default; no prompt or completion text is ever exported.
# Grafana Cloud is the intended backend: its OTLP endpoint takes OTLP/HTTP with basic auth —
# fill OTEL_EXPORTER_OTLP_ENDPOINT with your Grafana Cloud OTLP host and OTEL_EXPORTER_OTLP_HEADERS
# with `Authorization=Basic <base64(instance_id:api_token)>`.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ai-trainer
