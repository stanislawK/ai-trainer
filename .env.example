# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# PostgreSQL with pgvector (ADR-0004).
DATABASE_URL=postgresql+psycopg://ai_trainer:ai_trainer@localhost:5432/ai_trainer

# LLM gateway (ADR-0007, ADR-0018). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
LLM_CALL_TIMEOUT_SECONDS=30
# Local debugging only (ADR-0018): when true, every model request appends one JSON line with
# its prompt, reply, tokens, cost and timing to LLM_DEBUG_LOG_DIR/<UTC date>.jsonl. It holds
# athletes' words, so keep it off anywhere but your own machine; it never reaches traces.
LLM_DEBUG_LOG=false
LLM_DEBUG_LOG_DIR=.llm-debug/
# How many of the latest chat messages the router and every specialist see (ADR-0008).
CHAT_HISTORY_TURNS=10
# Days after its last message a conversation is hidden, then deleted by `make purge-conversations`
# (PRD-0004 B26, ADR-0021). At least 1.
CONVERSATION_RETENTION_DAYS=14
# Minutes after the latest log of a session in which a new log of the same sport is offered as an
# addition to it (PRD-0004 B16, ADR-0014). At least 1.
SESSION_MERGE_WINDOW_MIN=30
# Model of the `router` template (ADR-0008): a small, cheap stable/GA OpenRouter id, distinct
# from EVAL_JUDGE_MODEL. Required; there is no default. Picked at #188 on evals, the latency
# scenario and USD per log turn (ADR-0026 step 2 result).
ROUTER_MODEL=z-ai/glm-5.3-flash
# How OpenRouter picks the router's upstream (ADR-0026): a JSON object with any of `sort`
# (price, throughput or latency), `preferred_max_latency` (seconds, or e.g. {"p90": 2}),
# `quantizations` and `only`; fallbacks stay on and `order` is refused. Empty lets OpenRouter
# balance across every endpoint and quantization, so routing varies call to call (#127).
# A `quantizations` or `only` value fits one model's upstreams; re-tune it when the model changes.
# #188 measured {"sort":"latency","quantizations":["fp8","nvfp4"]} on glm-5.3-flash: log-turn p50
# 2.0 s, p95 9.4 s over 48 turns. The fp8/nvfp4 filter keeps calls off the mixed fp4 stacks (#127).
ROUTER_PROVIDER_PREFERENCES={"sort":"latency","quantizations":["fp8","nvfp4"]}
# Seconds a router call may take, above its measured worst case; empty uses
# LLM_CALL_TIMEOUT_SECONDS. #188 measured a maximum of 1.4 s on glm-5.3-flash.
ROUTER_CALL_TIMEOUT_SECONDS=5
# The router's reasoning effort (ADR-0026): none, minimal, low, medium, high, xhigh or max. A model
# without the level gets its nearest one. Empty sends none, so the model's default applies.
ROUTER_REASONING_EFFORT=
# Model of the `chitchat` specialist (ADR-0008): replies to chitchat, unclear and pain messages
# in the persona. A stable/GA OpenRouter id, distinct from EVAL_JUDGE_MODEL. Required.
CHITCHAT_MODEL=
# Model of every sport's extraction template (`climbing.extract`, ...; ADR-0008): turns a log
# into a session draft. A stable/GA OpenRouter id, distinct from EVAL_JUDGE_MODEL. Required.
# Picked at #188, like ROUTER_MODEL.
EXTRACT_MODEL=z-ai/glm-5.3-flash
# The extraction templates' provider preferences and call timeout, like the router's. #188
# measured call p95 7.8 s and a maximum of 22.5 s on glm-5.3-flash, so the timeout stays above it.
EXTRACT_PROVIDER_PREFERENCES={"sort":"latency","quantizations":["fp8","nvfp4"]}
EXTRACT_CALL_TIMEOUT_SECONDS=30
# The extraction templates' reasoning effort, like ROUTER_REASONING_EFFORT.
EXTRACT_REASONING_EFFORT=
# Jev decision model (ADR-0020): OpenRouter's versioned ID, called through its TypeSafe-compatible
# /api/v1/systemone with OPENROUTER_API_KEY. Never an alias such as ~typesafe/jev-latest.
DECISION_MODEL=typesafe/jev-1.13
# Seconds a decision may take before it falls back; short, because the message waits for it.
DECISION_CALL_TIMEOUT_SECONDS=2
# P(pain) at or above this flags a pain mention (safety_screen). Calibrated on its eval
# dataset and recorded in evals/baselines/safety_screen.json; change it via /tune-prompt.
SAFETY_SCREEN_PAIN_THRESHOLD=0.3
# The Jev router fast path (router_fast) routes a message itself only when P(several requests)
# is at or below the first and the picked intent's, and a log's sport's, probability is at or
# above the others; anything else goes to the LLM router. Calibrated on the router's eval cases
# and recorded in evals/baselines/router_fast.json; change them via /tune-prompt.
ROUTER_FAST_MULTI_REQUEST_THRESHOLD=0.15
ROUTER_FAST_INTENT_THRESHOLD=0.85
ROUTER_FAST_SPORT_THRESHOLD=0.9
# An athlete's sport with P(sport) at or above this floor stays plausible (router_fast); the
# athlete is asked which sport only when two or more do. Recorded in the same baseline.
ROUTER_FAST_PLAUSIBLE_SPORT_FLOOR=0.1

# Prompt evals (ADR-0009). A stable/GA OpenRouter model id, distinct from the model under
# test, used as the LLMJudge default via `set_default_judge_model`. Only read when you
# actually run `make evals` / `ai-trainer-evals` — never in the default `pytest` or CI.
EVAL_JUDGE_MODEL=

# Google sign-in (ADR-0005). Create an OAuth 2.0 client (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with authorized redirect URI
# http://localhost:8000/auth/callback. No Google access or refresh token is ever stored.
# The four keys below are required: the app refuses to start while any is blank, naming it.
# Step by step: README "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs Starlette's transient OAuth-state cookie; generate with `openssl rand -hex 32`.
SESSION_SECRET_KEY=
# Signs the CSRF token (ADR-0005); generate with `openssl rand -hex 32`. Kept separate from
# SESSION_SECRET_KEY.
CSRF_SECRET_KEY=
# Comma-separated; a verified Google email in this list bootstraps the first admin account
# as `active` (ADR-0005). Leave empty and every new account stays `pending`.
ADMIN_EMAILS=
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=14

# Tracing over OTLP (ADR-0018). Off by default; no prompt or completion text is ever exported.
# Grafana Cloud is the intended backend: its OTLP endpoint takes OTLP/HTTP with basic auth —
# fill OTEL_EXPORTER_OTLP_ENDPOINT with your Grafana Cloud OTLP host and OTEL_EXPORTER_OTLP_HEADERS
# with `Authorization=Basic <base64(instance_id:api_token)>`.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ai-trainer
