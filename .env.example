# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# PostgreSQL with pgvector (ADR-0004).
DATABASE_URL=postgresql+psycopg://ai_trainer:ai_trainer@localhost:5432/ai_trainer

# LLM gateway (ADR-0007, ADR-0018). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
LLM_CALL_TIMEOUT_SECONDS=30

# Tracing over OTLP (ADR-0018). Off by default; no prompt or completion text is ever exported.
# Grafana Cloud is the intended backend: its OTLP endpoint takes OTLP/HTTP with basic auth —
# fill OTEL_EXPORTER_OTLP_ENDPOINT with your Grafana Cloud OTLP host and OTEL_EXPORTER_OTLP_HEADERS
# with `Authorization=Basic <base64(instance_id:api_token)>`.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ai-trainer
