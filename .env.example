# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# PostgreSQL with pgvector (ADR-0004).
DATABASE_URL=postgresql+psycopg://ai_trainer:ai_trainer@localhost:5432/ai_trainer

# LLM gateway (ADR-0007, ADR-0018). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
LLM_CALL_TIMEOUT_SECONDS=30
# Sign-in routes per address, other requests per session, the knowledge API per admin token and
# its failed tokens per address, and model calls per user (ADR-0029, ADR-0036).
AUTH_REQUESTS_PER_MINUTE=10
SESSION_REQUESTS_PER_MINUTE=120
TOKEN_REQUESTS_PER_MINUTE=120
TOKEN_FAILURES_PER_ADDRESS_PER_MINUTE=10
LLM_CALLS_PER_USER_PER_HOUR=300
LLM_CALLS_IN_FLIGHT_PER_USER=8
# Local debugging only (ADR-0018): when true, every model request appends one JSON line with
# its prompt, reply, tokens, cost and timing to LLM_DEBUG_LOG_DIR/<UTC date>.jsonl. It holds
# athletes' words, so keep it off anywhere but your own machine; it never reaches traces.
# Startup fails when it is true and PUBLIC_BASE_URL's host is not localhost or 127.0.0.1.
LLM_DEBUG_LOG=false
LLM_DEBUG_LOG_DIR=.llm-debug/
# How many of the latest chat messages the router and every specialist see (ADR-0008).
CHAT_HISTORY_TURNS=10
# Days after its last message a conversation is hidden, then deleted by `make purge-conversations`
# (PRD-0004 B26, ADR-0021). At least 1.
CONVERSATION_RETENTION_DAYS=14
# The one dataset commit `make import-exercises` reads and the day that pin was fetched, shown in
# the attribution. They name the shipped defaults: leave them out of a production `.env`, and drop
# them from your own after trying a bump, or a later pin stays hidden (ADR-0031).
EXERCISE_DATASET_COMMIT=7455efae41b330c265e7cd4b78dfa848e7ce5ebd
EXERCISE_DATASET_FETCHED_ON=2026-10-31
EXERCISE_CATALOGUE_DIR=data/catalogue
# Minutes after the latest log of a session in which a new log of the same sport is offered as an
# addition to it (PRD-0004 B16, ADR-0014). At least 1.
SESSION_MERGE_WINDOW_MIN=30
# Model of the `router` template (ADR-0008): a small, cheap stable/GA OpenRouter id, distinct
# from EVAL_JUDGE_MODEL. Required; there is no default. Picked at #188 on evals, the latency
# scenario and USD per log turn (ADR-0026 step 2 result).
ROUTER_MODEL=z-ai/glm-5.3-flash
# How OpenRouter picks the router's upstream (ADR-0026): a JSON object with any of `sort`
# (price, throughput or latency), `preferred_max_latency` (seconds, or e.g. {"p90": 2}),
# `quantizations` and `only`; fallbacks stay on and `order` is refused. Empty lets OpenRouter
# balance across every endpoint and quantization, so routing varies call to call (#127).
# A `quantizations` or `only` value fits one model's upstreams; re-tune it when the model changes.
# #188 measured {"sort":"latency","quantizations":["fp8","nvfp4"]} on glm-5.3-flash: log-turn p50
# 2.0 s, p95 9.4 s over 48 turns. The fp8/nvfp4 filter keeps calls off the mixed fp4 stacks (#127).
ROUTER_PROVIDER_PREFERENCES={"sort":"latency","quantizations":["fp8","nvfp4"]}
# Seconds a router call may take, above its measured worst case; empty uses
# LLM_CALL_TIMEOUT_SECONDS. #436 measured a maximum of 7.5 s on glm-5.3-flash over 60 calls, from
# long reasoning and upstream wait, so 15 s lets a slow answer finish (G14).
ROUTER_CALL_TIMEOUT_SECONDS=15
# The router's reasoning effort (ADR-0026): none, minimal, low, medium, high, xhigh or max. A model
# without the level gets its nearest one. Empty sends none, so the model's default applies.
ROUTER_REASONING_EFFORT=
# Model of the `chitchat` specialist (ADR-0008): replies to chitchat, unclear and pain messages
# in the persona. A stable/GA OpenRouter id, distinct from EVAL_JUDGE_MODEL. Required.
CHITCHAT_MODEL=
# Model of every sport's extraction template (`climbing.extract`, ...; ADR-0008): turns a log
# into a session draft. A stable/GA OpenRouter id, distinct from EVAL_JUDGE_MODEL. Required.
# Picked at #188, like ROUTER_MODEL.
EXTRACT_MODEL=z-ai/glm-5.3-flash
# The extraction templates' provider preferences and call timeout, like the router's. #188
# measured call p95 7.8 s and a maximum of 22.5 s on glm-5.3-flash, so the timeout stays above it.
EXTRACT_PROVIDER_PREFERENCES={"sort":"latency","quantizations":["fp8","nvfp4"]}
EXTRACT_CALL_TIMEOUT_SECONDS=30
# The extraction templates' reasoning effort, like ROUTER_REASONING_EFFORT.
EXTRACT_REASONING_EFFORT=
# The four onboarding read templates (`onboarding.about_you`, ...; ADR-0028) share one group:
# they read answers in the background, off the critical path. Blank keeps the defaults picked on
# `onboarding.about_you`'s eval baseline (#254): z-ai/glm-5.3-flash at `low` effort on
# {"sort":"latency","quantizations":["fp8","nvfp4"]}. OpenRouter's default price sort lands on an
# upstream without structured outputs, which fails the read. The timeout falls back to
# LLM_CALL_TIMEOUT_SECONDS.
ONBOARDING_MODEL=
ONBOARDING_PROVIDER_PREFERENCES=
ONBOARDING_CALL_TIMEOUT_SECONDS=
ONBOARDING_REASONING_EFFORT=
# The `<sport>.answer` templates (B40) share one group: they answer a training question from the
# athlete's history through the MCP tools. Blank keeps the defaults: z-ai/glm-5.3-flash at `low`
# effort on {"sort":"latency","quantizations":["fp8","nvfp4"]}. The timeout bounds each wait on the
# model, a whole tool round included, and falls back to LLM_CALL_TIMEOUT_SECONDS.
ANSWER_MODEL=
ANSWER_PROVIDER_PREFERENCES=
ANSWER_CALL_TIMEOUT_SECONDS=
ANSWER_REASONING_EFFORT=
# The most model requests one answer's tool loop may make.
ANSWER_MAX_REQUESTS=6
# Jev decision model (ADR-0020): OpenRouter's versioned ID, called through its TypeSafe-compatible
# /api/v1/systemone with OPENROUTER_API_KEY. Never an alias such as ~typesafe/jev-latest.
DECISION_MODEL=typesafe/jev-1.13
# Seconds a decision may take before it falls back; short, because the message waits for it.
DECISION_CALL_TIMEOUT_SECONDS=2
# P(sport) at or above this counts a training question as that sport (question_sport). A miss costs
# a "not yet" reply. It moves on feedback, through /tune-prompt question_sport.
QUESTION_SPORT_THRESHOLD=0.7
# P(pain) at or above this flags a pain mention (safety_screen). Calibrated on its eval
# dataset and recorded in evals/baselines/safety_screen.json; change it via /tune-prompt.
SAFETY_SCREEN_PAIN_THRESHOLD=0.3
# The Jev router fast path (router_fast) routes a message itself only when P(several requests)
# is at or below the first and the picked intent's, and a log's sport's, probability is at or
# above the others; anything else goes to the LLM router. Calibrated on the router's eval cases
# and recorded in evals/baselines/router_fast.json; change them via /tune-prompt. #436 moved the
# first with the set's v2 wording: one sport's two-exercise logs score 0.24 or less, pain with a
# log or a list across two sports 0.43 or more.
ROUTER_FAST_MULTI_REQUEST_THRESHOLD=0.3
ROUTER_FAST_INTENT_THRESHOLD=0.85
ROUTER_FAST_SPORT_THRESHOLD=0.9
# An athlete's sport with P(sport) at or above this floor stays plausible (router_fast); the
# athlete is asked which sport only when two or more do. Recorded in the same baseline.
ROUTER_FAST_PLAUSIBLE_SPORT_FLOOR=0.1
# A choice card offers at most this many options (ADR-0015); a longer list of plausible sports
# is cut to the likeliest.
MAX_CLARIFICATION_OPTIONS=5
# A sport's extraction reads its context (the climbing kinds an athlete does) from this many of
# their latest sessions in that sport (#164).
EXTRACT_RECENT_SESSIONS=10
# Gym names (ADR-0031, #397): how similar a typed name must be to one of the athlete's aliases to
# reuse it with no question, how similar to an exercise to be a candidate, and how many candidates
# the card offers.
EXERCISE_NEAR_MATCH_THRESHOLD=0.75
EXERCISE_CANDIDATE_FLOOR=0.25
EXERCISE_SHORTLIST_SIZE=4
# Jev's pick from the shortlist fills the draft's exercise with no card only at or above this
# probability (ADR-0031, #399). Higher abstains more, and the card asks.
EXERCISE_PICK_THRESHOLD=0.9

# Object storage for admin-uploaded knowledge files (ADR-0033). These match the versitygw service
# in compose.dev.yaml, so `uv run ai-trainer storage-check` works against `make start` with no R2
# account. Set all of the endpoint, both keys and the bucket, or leave all four blank. In production
# use the R2 values: deploy/RUNBOOK.md section 14. R2's endpoint is
# https://<account id>.r2.cloudflarestorage.com, and its region is `auto`.
OBJECT_STORAGE_ENDPOINT=http://localhost:7070
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=ai_trainer_dev
OBJECT_STORAGE_SECRET_ACCESS_KEY=ai_trainer_dev_secret
OBJECT_STORAGE_UPLOADS_BUCKET=ai-trainer-uploads
# Seconds one storage request may take, its retries included.
OBJECT_STORAGE_TIMEOUT_SECONDS=60
# The largest knowledge file an admin may upload at /admin/knowledge, in MiB (ADR-0033). At most
# 90: Caddy passes no body over 100 MB on that route, as Cloudflare caps it (ADR-0029).
KNOWLEDGE_MAX_UPLOAD_MB=50

# Knowledge embeddings (ADR-0033), sent by `uv run ai-trainer ingest-worker` with
# OPENROUTER_API_KEY. The model and dimension are recorded on every chunk; EMBEDDING_DIM must be
# 1024, the column's size. The provider preference pins one upstream with a one-name `only`:
# moving upstream counts as changing the model and means a re-embed. Blank keeps the pin.
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER_PREFERENCES=
EMBEDDING_CALL_TIMEOUT_SECONDS=60
# Ingestion (ADR-0036, #423). Inputs per embedding call, and attempts per batch when OpenRouter
# answers 429. The chunk budget in words, and the size under which a section merges with a
# sibling (provisional until the retrieval checks). The worker's lease on a source, renewed
# every third of it, and how often an idle worker looks for work, in seconds.
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_EMBEDDING_MAX_ATTEMPTS=5
KNOWLEDGE_CHUNK_MAX_WORDS=300
KNOWLEDGE_CHUNK_MIN_WORDS=80
KNOWLEDGE_INGEST_LEASE_SECONDS=300
KNOWLEDGE_INGEST_POLL_SECONDS=5
# search_knowledge (ADR-0036, #424): seconds a query's embedding call may take before the search
# fails with a recovery hint, and how many chunks each leg reads before fusion (1-100).
KNOWLEDGE_QUERY_TIMEOUT_SECONDS=10
KNOWLEDGE_SEARCH_DEPTH=20
# PMC's Cloud Service bucket (public, no login), read by PMC ID when an admin token stages papers
# at /api/admin/knowledge/stage/pmc (ADR-0036). The timeout bounds one article's two GETs; at most 10.
PMC_BUCKET_URL=https://pmc-oa-opendata.s3.amazonaws.com
PMC_TIMEOUT_SECONDS=8
# The ingest worker's download of an approved article's JATS XML, one deadline for the file; at most 120.
PMC_JATS_TIMEOUT_SECONDS=30

# Prompt evals (ADR-0009). A stable/GA OpenRouter model id, distinct from the model under
# test, used as the LLMJudge default via `set_default_judge_model`. Only read when you
# actually run `make evals` / `ai-trainer-evals` — never in the default `pytest` or CI.
EVAL_JUDGE_MODEL=

# Google sign-in (ADR-0005). Create an OAuth 2.0 client (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with authorized redirect URI
# http://localhost:8000/auth/callback. No Google access or refresh token is ever stored.
# The four keys below are required: the app refuses to start while any is blank, naming it.
# Step by step: README "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs Starlette's transient OAuth-state cookie; generate with `openssl rand -hex 32`.
SESSION_SECRET_KEY=
# Signs the CSRF token (ADR-0005); generate with `openssl rand -hex 32`. Kept separate from
# SESSION_SECRET_KEY.
CSRF_SECRET_KEY=
# Comma-separated; a verified Google email in this list bootstraps the first admin account
# as `active` (ADR-0005). Leave empty and every new account stays `pending`.
ADMIN_EMAILS=
# The one origin the app is served from, no path (ADR-0023): `http://localhost:8000` locally,
# `https://<your domain>` in production. The Google redirect URI is this plus /auth/callback, and
# only this host is accepted in a request's Host header (anything else gets 400), so open the app
# at exactly this address. Required.
PUBLIC_BASE_URL=http://localhost:8000
SESSION_COOKIE_SECURE=true
SESSION_TTL_DAYS=14

# Tracing and metrics over OTLP (ADR-0018, ADR-0030). Off by default; no prompt or completion
# text is ever exported, and no metric label names a user, a request or a raw path.
# For local use only: point OTEL_EXPORTER_OTLP_ENDPOINT at a local collector such as otel-lgtm
# (http://localhost:4318). In production leave the OTEL_* keys (bar the sampler ratio below),
# APP_VERSION and DEPLOYMENT_ENVIRONMENT out of .env: compose.prod.yaml sets what production needs
# and the rest keep their defaults. The app sends to Alloy, which holds the only Grafana Cloud
# credentials (ADR-0030 invariant 1, deploy/RUNBOOK.md §6).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=ai-trainer
# Every request is traced, from the HTTP span through its queries and outbound calls (ADR-0030).
# The ratio of new traces kept (0.0-1.0); a request with a sampled parent stays sampled.
OTEL_TRACES_SAMPLER_RATIO=1.0
# Each span's `service.version` and `deployment.environment`; production sets the release tag.
APP_VERSION=dev
DEPLOYMENT_ENVIRONMENT=development

# Logs on stdout (ADR-0030). `json` writes one JSON object per line with trace_id, span_id,
# request_id (also returned as X-Request-ID) and the signed-in user's opaque user_id; production
# sets it in compose.prod.yaml. `text` (the default) is plain lines for local work.
LOG_FORMAT=text
LOG_LEVEL=INFO
