# Production ingress (ADR-0023, ticket #221). Cloudflare proxies to this origin in Full (strict)
# mode: Caddy serves the Cloudflare Origin CA certificate and accepts only connections that
# present the zone's Authenticated Origin Pulls client certificate. mode is set explicitly
# to require_and_verify, so a later Caddy image cannot fall back to request.
{
	# Certificates are files, never ACME; there is no port 80 to redirect from.
	auto_https off
	# compose.prod.yaml publishes 443/tcp only, so don't advertise HTTP/3 (alt-svc: h3) over UDP.
	# Each server is named, so its metrics carry a fixed `server` label instead of Caddy's
	# generated srv0/srv1, whose order follows the sites': `public` is 443, `metrics` the
	# listener at the end of this file, whose own series Alloy drops (#273).
	servers :443 {
		name public
		protocols h1 h2
	}
	servers 10.222.0.10:9180 {
		name metrics
		protocols h1 h2
	}
	# Prometheus metrics for Alloy (ADR-0030, #273), served only by the site at the end of this
	# file. No `per_host`: one site, and fewer series.
	metrics
}

https://{$SITE_HOST} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/aop-ca.pem
		}
	}

	header Strict-Transport-Security "max-age=31536000"

	# Chat and onboarding forms are a few kilobytes (ADR-0029). The one upload, an admin's
	# knowledge file (ADR-0033, #422), may reach Cloudflare's own 100 MB cap; the app enforces
	# KNOWLEDGE_MAX_UPLOAD_MB below that. The two matchers exclude each other, since both
	# limits would otherwise apply and the smaller would win.
	# `request_body` is in the stock caddy:2.11.7 image. A larger body is 413.
	@knowledge_upload {
		method POST
		path /admin/knowledge/sources
	}
	@not_knowledge_upload {
		not {
			method POST
			path /admin/knowledge/sources
		}
	}
	request_body @knowledge_upload {
		max_size 100MB
	}
	request_body @not_knowledge_upload {
		max_size 256KiB
	}

	# Passes the original Host on, which TrustedHostMiddleware checks against PUBLIC_BASE_URL.
	reverse_proxy app:8000
}

# Caddy's metrics, only on the internal `metrics` network that Alloy alone shares
# (compose.prod.yaml gives Caddy and Alloy fixed addresses there). Never through 443: that site
# has no `metrics` directive, so /metrics there goes to the app, whose sign-in gate answers 401.
# The admin API keeps its own /metrics on localhost:2019, inside this container.
# Only Alloy's address is served. A host can route another network's traffic into an internal
# bridge (OrbStack does, from `edge`), and that traffic arrives from the bridge's gateway.
http://10.222.0.10:9180 {
	bind 10.222.0.10
	@alloy remote_ip 10.222.0.20
	handle @alloy {
		metrics
	}
	handle {
		respond 403
	}
}
