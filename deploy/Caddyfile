# Production ingress (ADR-0023, ticket #221). Cloudflare proxies to this origin in Full (strict)
# mode: Caddy serves the Cloudflare Origin CA certificate and accepts only connections that
# present the zone's Authenticated Origin Pulls client certificate. mode is set explicitly
# to require_and_verify, so a later Caddy image cannot fall back to request.
{
	# Certificates are files, never ACME; there is no port 80 to redirect from.
	auto_https off
	# compose.prod.yaml publishes 443/tcp only, so don't advertise HTTP/3 (alt-svc: h3) over UDP.
	servers {
		protocols h1 h2
	}
}

https://{$SITE_HOST} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/aop-ca.pem
		}
	}

	header Strict-Transport-Security "max-age=31536000"

	# No upload exists. Chat and onboarding forms are a few kilobytes (ADR-0029).
	# `request_body` is in the stock caddy:2.11.7 image. A larger body is 413.
	request_body {
		max_size 256KiB
	}

	# Passes the original Host on, which TrustedHostMiddleware checks against PUBLIC_BASE_URL.
	reverse_proxy app:8000
}
