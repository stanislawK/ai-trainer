# Alloy's Grafana Cloud credentials (ADR-0030 invariant 1), at ${CONFIG_DIR}/alloy.env
# (/opt/ai-trainer/alloy.env, mode 0600), read by the alloy service only. deploy/RUNBOOK.md,
# section 11, says where each value comes from. The token's access policy allows only
# traces:write, logs:write and metrics:write.
GRAFANA_CLOUD_OTLP_URL=
GRAFANA_CLOUD_OTLP_USER=
GRAFANA_CLOUD_LOGS_URL=
GRAFANA_CLOUD_LOGS_USER=
GRAFANA_CLOUD_TOKEN=
