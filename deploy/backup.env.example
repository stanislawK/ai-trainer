# /opt/ai-trainer/backup.env on the server, mode 0600, owned by deploy (ticket #223). Read by
# ai-trainer-backup.service and by deploy.sh before a migration. deploy/RUNBOOK.md, section 8.
#
# The rclone destination: the `r2` remote below and the bucket name.
BACKUP_DEST=r2:ai-trainer-backups
# The owner's age public key. The private key never comes to the server.
BACKUP_AGE_RECIPIENT=age1replacewiththeownerspublickey
# The `r2` remote, configured by environment alone (no rclone.conf).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# The bucket-scoped "Object Read & Write" token's S3 credentials.
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# The token can't create buckets, so rclone mustn't check or create one.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
# The bucket locks version every object, and rclone checks each upload with HEAD ?versionId=,
# which R2 answers with 501 Not Implemented: the upload succeeded but rclone reports it failed
# (#227). Skip that check; the PUT carries Content-MD5, and the restore drill verifies the rest.
RCLONE_CONFIG_R2_NO_HEAD=true
