# /opt/ai-trainer/deploy.env on the server, mode 0600, owned by deploy (ticket #225). Read by
# ai-trainer-deploy.service. deploy/RUNBOOK.md, section 10. The GitHub token is not here: it's
# /opt/ai-trainer/github-token, which systemd hands the service as a credential.
#
# The host of PUBLIC_BASE_URL. compose.prod.yaml gives it to Caddy, and deploy.sh checks
# https://<it>/health through Cloudflare after a deploy.
SITE_HOST=trainer.example.com
