# ~/.config/ai-trainer/restore.env on your laptop, mode 0600 (ticket #224). Read by the restore
# drill, deploy/restore-drill.sh, never by the server. deploy/RUNBOOK.md, section 8.6.
#
# The rclone destination: the `r2` remote below and the bucket name.
BACKUP_DEST=r2:ai-trainer-backups
# Your offline age key file (the private key from section 8.1). Read on this machine only.
# The file is sourced by the shell: quote a path with spaces ("…/My Keys/…").
RESTORE_AGE_IDENTITY=/path/to/ai-trainer-backup.key
# The `r2` remote, configured by environment alone (no rclone.conf).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# A bucket-scoped "Object Read only" token's S3 credentials: not the server's read-write one.
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
