# The nightly backup (ADR-0023 "Backups", ticket #223): pg_dump, encrypted with age to the owner's
# key, uploaded to R2. Started by ai-trainer-backup.timer; deploy/RUNBOOK.md installs both.
[Unit]
Description=ai-trainer nightly database backup to R2
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
# BACKUP_DEST, BACKUP_AGE_RECIPIENT and the R2 token (deploy/backup.env.example), mode 0600.
EnvironmentFile=/opt/ai-trainer/backup.env
ExecStart=/opt/ai-trainer/deploy/backup.sh nightly
# A oneshot has no start timeout by default; a hung rclone would stay activating and
# systemd would skip later nights.
TimeoutStartSec=30min
# The journal identifier Alloy keeps (ADR-0030, #274); without it the journal says `backup.sh`.
SyslogIdentifier=ai-trainer-backup
# backup.sh prints its own outcome line, but KillSignal=SIGKILL on a timeout gives it no chance
# to. This prints the failed line then, and only then, so a run never has two (ADR-0030, #274).
# `$$` is systemd's escape for a literal `$`.
ExecStopPost=/bin/sh -c 'case "$$SERVICE_RESULT" in timeout|signal|watchdog) echo "backup: result=failed reason=killed";; esac'
# SIGTERM can kill backup.sh first. That closes the pipe, rclone sees end-of-input, and a
# truncated object is stored under the bucket lock. SIGKILL stops rclone before it can finish.
# The deploy unit keeps SIGTERM: deploy.sh traps it so a timed-out deploy still rolls back.
KillSignal=SIGKILL
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
