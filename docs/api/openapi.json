                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Save Edit"
      }
    },
    "/drafts/{draft_id}/sport": {
      "post": {
        "description": "The draft card's sport chip (B23, F2, ticket #163): re-runs the picked sport's\nextraction on the draft's own log and answers with the new card, which replaces the\nold one; no session is written. A sport the chip never offered is a 422, a confirmed or\ndiscarded draft a 409, and another user's or an unknown one a 404, none of them calling\nthe model. A failed extraction answers with the card as it was and a note to pick\nagain.",
        "operationId": "change_sport_drafts__draft_id__sport_post",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
