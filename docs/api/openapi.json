      "post": {
        "description": "The draft card's Discard (F2, ADR-0022): throws the athlete's draft away without\nsaving a session and answers with its \"Draft discarded\" row, which replaces the card.\nA second discard answers with the same row. A confirmed draft is a 409 and changes\nnothing.",
        "operationId": "discard_drafts__draft_id__discard_post",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
