                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Change Sport"
      }
    },
    "/drafts/{draft_id}/undo": {
      "post": {
        "description": "The confirmed row's Undo (B4, ADR-0022): takes the athlete's just-saved log back from\nits session, once the browser's prompt is accepted, and answers with the \"Removed\" row,\nwhich replaces the confirmed one. The session's other logs stay (#165). Another user's\nor an unknown draft, and one with no session left to undo, is a 404 and nothing is\ndeleted.",
        "operationId": "undo_drafts__draft_id__undo_post",
        "parameters": [
          {
            "in": "path",
            "name": "draft_id",
            "required": true,
            "schema": {
