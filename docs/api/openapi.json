    "/clarifications/{clarification_id}/abandon": {
      "post": {
        "description": "A choice card's \"Let me type instead\" (F9, invariant 2 of ADR-0015): closes the\nquestion and writes nothing else; the composer takes focus after the swap. An answered\nor skipped question is a 409, another user's or an unknown one a 404.",
        "operationId": "abandon_clarifications__clarification_id__abandon_post",
        "parameters": [
          {
            "in": "path",
            "name": "clarification_id",
            "required": true,
            "schema": {
              "title": "Clarification Id",
              "type": "string"
